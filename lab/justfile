set windows-shell := ["cmd.exe", "/c"]

default: watch

# build + run host + auto-rebuild on every src/ save (the normal dev loop)
watch:
    python build.py watch

# one-shot DLL/host build, no watch
build:
    python build.py hot

# headless input/sim test (no window) — agent-runnable
test:
    python build.py test

clean:
    python build.py clean

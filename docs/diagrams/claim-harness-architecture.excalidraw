    { "type": "text", "id": "t_equiv", "x": 1078, "y": 444, "width": 330, "height": 20, "text": "equiv A B   (refactor-equivalence)", "originalText": "equiv A B   (refactor-equivalence)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100070, "version": 1, "versionNonce": 100071, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "rectangle", "id": "be_faster", "x": 1044, "y": 540, "width": 392, "height": 64, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100072, "version": 1, "versionNonce": 100073, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "t_faster", "x": 1058, "y": 552, "width": 370, "height": 40, "text": "faster A B k   ◂ was  bench\n-o:speed ~1100ms · timed serial", "originalText": "faster A B k   ◂ was  bench\n-o:speed ~1100ms · timed serial", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7c2d12", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100074, "version": 1, "versionNonce": 100075, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 },
    { "type": "text", "id": "t_composite", "x": 1044, "y": 614, "width": 400, "height": 38, "text": "composite = an equiv line AND a faster line, one dir\n→ two leaves, no combinator (no DSL)", "originalText": "composite = an equiv line AND a faster line, one dir\n→ two leaves, no combinator (no DSL)", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100076, "version": 1, "versionNonce": 100077, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 },
    { "type": "rectangle", "id": "perf_box", "x": 1044, "y": 666, "width": 392, "height": 150, "strokeColor": "#0f172a", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100078, "version": 1, "versionNonce": 100079, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "t_perf", "x": 1060, "y": 682, "width": 366, "height": 125, "text": "perf protocol (deterministic)\n  warmup 3 · N=15 interleaved A/B\n  min-of-N · k = 1.5\n  DCE-sink: variant :: proc() -> u64\n  noise band ±15% · two-batch agree", "originalText": "perf protocol (deterministic)\n  warmup 3 · N=15 interleaved A/B\n  min-of-N · k = 1.5\n  DCE-sink: variant :: proc() -> u64\n  noise band ±15% · two-batch agree", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#fcd34d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100080, "version": 1, "versionNonce": 100081, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.4 },

    { "type": "rectangle", "id": "build_box", "x": 360, "y": 560, "width": 416, "height": 150, "strokeColor": "#0f172a", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100090, "version": 1, "versionNonce": 100091, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "t_build", "x": 376, "y": 576, "width": 392, "height": 125, "text": "build & parallelism (measured)\n  build ≠ run — one artifact feeds equiv + faster\n  correctness: -o:none · ~200ms · pool 4\n  faster: -o:speed ~1100ms · timing serialized\n  no Odin cache · 11 concurrent → only 1.6×", "originalText": "build & parallelism (measured)\n  build ≠ run — one artifact feeds equiv + faster\n  correctness: -o:none · ~200ms · pool 4\n  faster: -o:speed ~1100ms · timing serialized\n  no Odin cache · 11 concurrent → only 1.6×", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#93c5fd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100092, "version": 1, "versionNonce": 100093, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.4 },


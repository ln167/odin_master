    { "type": "text", "id": "t_atom", "x": 378, "y": 306, "width": 392, "height": 145, "text": "claims/bresenham/\n  variant.odin   variant_A/_B -> u64\n  claim.txt      faster A B 1.5\n\n  tests/<name>/  = implicit 'output' claim\n  dir + one keyword line · no YAML/DSL", "originalText": "claims/bresenham/\n  variant.odin   variant_A/_B -> u64\n  claim.txt      faster A B 1.5\n\n  tests/<name>/  = implicit 'output' claim\n  dir + one keyword line · no YAML/DSL", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#86efac", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100034, "version": 1, "versionNonce": 100035, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.4 },
